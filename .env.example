# ==========================================
# REVIVEPAY ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Razorpay Test Mode Credentials
# Get your Test Key ID and Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_mock_revivepay
RAZORPAY_KEY_SECRET=mock_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# 2. Google Gemini AI API Key (For Multi-Agent Pipeline)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# 3. Firebase Firestore Configuration (Optional - Resilient in-memory store active by default)
# Get your Firebase Web app config from https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=revivepay-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=revivepay-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=revivepay-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1029384756
NEXT_PUBLIC_FIREBASE_APP_ID=1:1029384756:web:abcd1234ef5678
